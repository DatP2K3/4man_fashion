        <createTable tableName="membership_tiers">
            <column name="id" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="membership_tiers_pkey"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="created_by" type="UUID"/>
            <column name="last_modified_by" type="UUID"/>
            <column name="cashback_percentage" type="FLOAT8"/>
            <column name="default_tier" type="BOOLEAN"/>
            <column name="deleted" type="BOOLEAN"/>
            <column name="min_points" type="INTEGER"/>
            <column name="name" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>
    <changeSet author="DatDZ2k3" id="1752330623888-4">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="profiles"/>
