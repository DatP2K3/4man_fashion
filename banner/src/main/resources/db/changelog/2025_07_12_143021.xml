<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext" xmlns:pro="http://www.liquibase.org/xml/ns/pro" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd http://www.liquibase.org/xml/ns/pro http://www.liquibase.org/xml/ns/pro/liquibase-pro-latest.xsd http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet author="DatDZ2k3" id="1752330623888-1">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="banners"/>
            </not>
        </preConditions>
        <createTable tableName="banners">
            <column name="id" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="banners_pkey"/>
            </column>
            <column name="deleted" type="BOOLEAN"/>
            <column name="file_id" type="UUID"/>
            <column name="position" type="INTEGER"/>
            <column name="title" type="VARCHAR(255)"/>
            <column name="type" type="VARCHAR(255)"/>
            <column name="test" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>
    <changeSet author="DatDZ2k3" id="1752330623888-2">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="cashback_transactions"/>
            </not>
        </preConditions>
        <createTable tableName="cashback_transactions">
            <column name="id" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="cashback_transactions_pkey"/>
            </column>
            <column name="amount" type="BIGINT"/>
            <column name="description" type="VARCHAR(255)"/>
            <column name="order_id" type="UUID"/>
            <column name="type" type="VARCHAR(255)"/>
            <column name="user_id" type="UUID"/>
        </createTable>
    </changeSet>
    <changeSet author="DatDZ2k3" id="1752330623888-3">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="membership_tiers"/>
