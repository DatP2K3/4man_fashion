            <column name="notification_id" type="UUID"/>
            <column name="seen_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="send_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="status" type="VARCHAR(255)"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="created_by" type="UUID"/>
            <column name="last_modified_by" type="UUID"/>
            <column name="read" type="BOOLEAN"/>
        </createTable>
    </changeSet>
    <changeSet author="DatDZ2k3" id="1752895115779-5">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="user_topics"/>
