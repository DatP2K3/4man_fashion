# ============================================
# 4Man Fashion - Environment Variables TEMPLATE
# ============================================
# Copy this file to .env and fill in actual values.
# NEVER commit .env with real secrets!
# ============================================

# === Database ===
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
DBMS_PASSWORD=changeme
DB_PASSWORD=changeme

# === RabbitMQ ===
RABBITMQ_USER=admin
RABBITMQ_PASS=changeme
RABBITMQ_PASSWORD=changeme
SPRING_RABBITMQ_PASSWORD=changeme

# === Keycloak ===
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme
KEYCLOAK_CLIENT_ID=iam_service
KEYCLOAK_CLIENT_SECRET=changeme

# === Config Server ===
GIT_USERNAME=changeme
GIT_PASSWORD=changeme
ENCRYPT_KEY=changeme

# === Application ===
APP_BASE_URL=http://localhost:8080
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200

# === VNPay ===
VNPAY_TMNCODE=changeme
VNPAY_SECRET_KEY=changeme
VNPAY_RETURN_URL=http://my_payment_service:8008/api/vn-pay-callback
PAYMENT_REDIRECT_URL=http://localhost:4200/order-successed

# === GHN (Giao Hang Nhanh) ===
GHN_URL=https://online-gateway.ghn.vn
GHN_TOKEN=changeme
GHN_ID=changeme

# === Mail ===
MAIL_USERNAME=changeme@gmail.com
MAIL_PASSWORD=changeme
