<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext" xmlns:pro="http://www.liquibase.org/xml/ns/pro" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd http://www.liquibase.org/xml/ns/pro http://www.liquibase.org/xml/ns/pro/liquibase-pro-latest.xsd http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet author="DatDZ2k3" id="1752904029879-1">
        <createTable tableName="files">
            <column name="id" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="files_pkey"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="created_by" type="UUID"/>
            <column name="last_modified_by" type="UUID"/>
            <column name="deleted" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="file_height" type="INTEGER"/>
            <column name="file_size" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="file_type" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="file_width" type="INTEGER"/>
            <column name="is_public" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="md5_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="origin_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="url" type="VARCHAR(255)"/>
            <column name="usage_status" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>
    <changeSet author="DatDZ2k3" id="1752904029879-2">
        <createTable tableName="payment_transactions">
            <column name="id" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="payment_transactions_pkey"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="created_by" type="UUID"/>
            <column name="last_modified_by" type="UUID"/>
            <column name="amount" type="BIGINT"/>
            <column name="order_code" type="VARCHAR(255)"/>
            <column name="pay_date" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="status" type="SMALLINT"/>
            <column name="transaction_code" type="VARCHAR(255)"/>
            <column name="transaction_info" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>
    <changeSet author="DatDZ2k3" id="1752904029879-3">
        <createTable tableName="file_histories">
            <column name="id" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="file_histories_pkey"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="created_by" type="UUID"/>
            <column name="last_modified_by" type="UUID"/>
            <column name="action" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="file_id" type="UUID">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>
