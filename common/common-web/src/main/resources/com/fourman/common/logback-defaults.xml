<?xml version="1.0" encoding="UTF-8"?>
<included>
    <!--
        Shared logback config for all 4man services.
        Include this in your service's logback-spring.xml:
        <include resource="com/fourman/common/logback-defaults.xml"/>
    -->

    <!-- Console pattern with correlation ID -->
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %highlight(%-5level) [%thread] [%X{correlationId:-NO_CID}] %cyan(%logger{36}) - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>
</included>
