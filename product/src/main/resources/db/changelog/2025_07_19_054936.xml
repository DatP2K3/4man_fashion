    <changeSet author="DatDZ2k3" id="1752904178109-1">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="discounts"/>
            </not>
        </preConditions>
        <createTable tableName="discounts">
            <column name="id" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="discounts_pkey"/>
            </column>
            <column name="percentage" type="INTEGER"/>
            <column name="discount_price" type="BIGINT"/>
            <column name="discount_quantity" type="INTEGER"/>
            <column name="discount_type" type="VARCHAR(255)"/>
            <column name="end_date" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="product_id" type="UUID"/>
            <column name="start_date" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="status" type="VARCHAR(255)"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="created_by" type="UUID"/>
            <column name="last_modified_by" type="UUID"/>
            <column name="name" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>
